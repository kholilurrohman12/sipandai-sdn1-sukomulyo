# Firebase Web App configuration
VITE_FIREBASE_API_KEY=isi_dari_firebase
VITE_FIREBASE_AUTH_DOMAIN=project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-id
VITE_FIREBASE_STORAGE_BUCKET=project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=isi_dari_firebase
VITE_FIREBASE_APP_ID=isi_dari_firebase

# Optional: only if you intentionally use Gemini directly from the browser.
# WARNING: VITE_ variables are bundled into client code. Do not put private server secrets here.

# Gemini API (server-side Vercel Environment Variable; DO NOT use VITE_ prefix)
GEMINI_API_KEY=isi_di_Vercel
GEMINI_MODEL=gemini-3.8-flash
