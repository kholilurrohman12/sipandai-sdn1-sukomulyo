rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEVELOPMENT RULES ONLY.
    // These rules allow any Firebase-authenticated session to access SIPANDAI data.
    // Before real school deployment, replace this with role-based rules using
    // Firebase Authentication (email/password) + protected user profile documents.
    match /artifacts/{appId}/public/data/{collection}/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
